{
  "name": "amazing-pet",
  "version": "1.0.0",
  "private": true,
  "description": "非遗知识桌面宠物",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check pet-state.js",
    "package": "electron-packager . amazing-pet --out=dist --overwrite --asar --ignore=^/dist --ignore=^/\\.github --ignore=^/tests",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "^43.0.0"
  }
}
